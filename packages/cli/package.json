{
  "name": "harnext",
  "version": "1.8.1",
  "description": "AI coding agent with harness engineering — interactive REPL, MCP support, and a GitHub-issue-driven workflow runner.",
  "type": "module",
  "bin": {
    "harnext": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.2",
    "@earendil-works/pi-ai": "^0.74.2",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.4.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@harnext/core": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "cli",
    "claude",
    "openai",
    "anthropic",
    "ollama",
    "mcp",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QualityUnit/harnext.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/QualityUnit/harnext#readme",
  "bugs": {
    "url": "https://github.com/QualityUnit/harnext/issues"
  },
  "publishConfig": {
